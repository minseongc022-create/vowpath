# OpenAI-compatible API (OpenAI, Azure, OpenRouter, local gateway, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# If unset or MOCK_LLM=1, runs offline with deterministic mock writer (for tests/dev)
MOCK_LLM=0

# WordPress (Application Password) — or save via dashboard
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Blogger (OAuth access token + blog id) — or save via dashboard
BLOGGER_BLOG_ID=
BLOGGER_ACCESS_TOKEN=

# Naver (export mode — no official post API)
NAVER_BLOG_ID=

# Publishing
PUBLISH_MODE=draft
# draft | publish | filesystem

# Overnight batch size per brand
POSTS_PER_BRAND=1
OUTPUT_DIR=./data/output

# Notifications when generate-all / nightly completes
NOTIFY_WEBHOOK_URL=
NTFY_TOPIC=

# Local dashboard port (npm run dashboard)
DASHBOARD_PORT=3847
