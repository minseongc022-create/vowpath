{
  "name": "effiroad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:kill": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev-ports.ps1",
    "build": "next build",
    "postbuild": "node scripts/postbuild-migrate-kv.mjs",
    "start": "next start",
    "lint": "next lint",
    "tunnel": "npx --yes localtunnel --port 3000",
    "twilio:webhook": "node scripts/twilio-setup-webhook.mjs",
    "twilio:register": "node scripts/register-twilio-all.mjs",
    "twilio:check": "node scripts/check-twilio-webhooks.mjs",
    "twilio:status": "node scripts/twilio-account-status.mjs",
    "twilio:verify": "node scripts/verify-caller-id.mjs",
    "twilio:verified": "node scripts/list-verified-caller-ids.mjs",
    "sms:link-intake": "node scripts/send-link-intake-sms.mjs",
    "sms:diagnose": "node scripts/sms-diagnose.mjs",
    "e2e:smart-booking": "node scripts/run-smart-booking-e2e.mjs",
    "e2e:sms-flows": "node scripts/run-sms-flows-e2e.mjs",
    "e2e:twilio-inbound": "node scripts/run-twilio-inbound-e2e.mjs",
    "e2e:booking-modes": "node scripts/run-smart-booking-e2e.mjs",
    "check:prod": "node scripts/check-production-readiness.mjs",
    "seed:dev-user": "node scripts/seed-dev-user.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs && node scripts/test-priority-guardrails.mjs",
    "test:e2e": "node scripts/run-all-tests.mjs",
    "test:e2e:live": "node scripts/run-live-sms-smoke.mjs",
    "launch:check": "node scripts/e2e-checklist.mjs",
    "launch:register": "node scripts/register-twilio-all.mjs",
    "launch:verify": "node scripts/verify-twilio-webhooks.mjs"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.5.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
