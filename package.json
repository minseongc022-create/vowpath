{
  "name": "hvac-nightcall-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:kill": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev-ports.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tunnel": "npx --yes localtunnel --port 3000",
    "twilio:webhook": "node scripts/twilio-setup-webhook.mjs",
    "twilio:register": "node scripts/register-twilio-all.mjs",
    "twilio:check": "node scripts/check-twilio-webhooks.mjs",
    "twilio:status": "node scripts/twilio-account-status.mjs",
    "twilio:verify": "node scripts/verify-caller-id.mjs",
    "twilio:verified": "node scripts/list-verified-caller-ids.mjs",
    "sms:link-intake": "node scripts/send-link-intake-sms.mjs",
    "sms:diagnose": "node scripts/sms-diagnose.mjs",
    "e2e:speed-booking": "node scripts/run-speed-booking-e2e.mjs",
    "e2e:hybrid-booking": "node scripts/run-hybrid-booking-e2e.mjs",
    "e2e:control-booking": "node scripts/run-control-booking-e2e.mjs",
    "e2e:booking-modes": "node scripts/run-speed-booking-e2e.mjs && node scripts/run-hybrid-booking-e2e.mjs && node scripts/run-control-booking-e2e.mjs"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
