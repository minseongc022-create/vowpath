# Environment Configuration
# Copy this to .env.local and fill in your API keys

# ===== ALPACA API =====
# Get from: https://app.alpaca.markets/brokerage/account/api-keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_API_BASE=https://api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# ===== OPENAI API =====
# Get from: https://platform.openai.com/api-keys
# Used by Effiroad intake, Learn/TOPIK AI grading, Whisper speech-to-text
OPENAI_API_KEY=

# TOPIK Master VN — optional model overrides (defaults: gpt-4o writing, gpt-4o-mini speaking)
# TOPIK_OPENAI_MODEL_WRITING=gpt-4o
# TOPIK_OPENAI_MODEL_SPEAKING=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# LEARN_OPENAI_API_KEY=  # Learn-only override if different from OPENAI_API_KEY

# ===== NEWS APIS =====
# Finnhub: https://finnhub.io/dashboard/api-keys
FINNHUB_API_KEY=

# NewsAPI: https://newsapi.org/account
NEWS_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/api/
ALPHA_VANTAGE_API_KEY=

# ===== DEPLOYMENT =====
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Giu (Vietnam food rescue) — custom domain
# NEXT_PUBLIC_GIU_URL=https://www.giucuu.com
# NEXT_PUBLIC_GIU_HOST=giucuu.com
# GIU_DOMAIN=giucuu.com   # for npm run giu:domain

# ===== PRICEPULSE (Toss Shopping price & rank intelligence) =====
# Collector identity — put a real contact address here before collecting.
PRICEPULSE_CONTACT=
# PRICEPULSE_USER_AGENT=            # full UA override; default is PricepulseBot/0.1 (+contact: ...)
# PRICEPULSE_MIN_GAP_MS=1500        # minimum gap between requests (crawl-delay wins if larger)
# PRICEPULSE_TIMEOUT_MS=15000
# PRICEPULSE_RETRIES=3
# PRICEPULSE_PAGES=2                # result pages per target, unless the target overrides
# PRICEPULSE_MAX_PAGES=5
# PRICEPULSE_RESPECT_ROBOTS=1       # 0 only if you have written permission from the source
# PRICEPULSE_ALLOW_UNVERIFIED_PROFILE=0   # 1 = allow collecting with a probe-proposed profile
# PRICEPULSE_CONFIG_DIR=            # override pricepulse/config

# Storage: Supabase project dedicated to pricepulse (schema: pricepulse/sql/001_init.sql).
# Unset ⇒ NDJSON files under pricepulse/data/ (fine for local development).
PRICEPULSE_SUPABASE_URL=
PRICEPULSE_SUPABASE_SERVICE_ROLE_KEY=

# Collection failure alerts — any endpoint that accepts a JSON POST
# (Slack/Discord webhook, or Make/Zapier → KakaoTalk).
PRICEPULSE_ALERT_WEBHOOK=

# Dashboard (app/(pricepulse)/pricepulse/*) — seller signup/login, self-serve keyword tracking.
# PRICEPULSE_DASHBOARD_SECRET=     # JWT signing key for seller session cookies; falls back to AUTH_SECRET

# Pro-plan checkout — reuses the same Toss Payments merchant account as Giu
# (see docs/GIU_TOSS_PAYMENTS.md). No separate merchant signup needed.
# NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_...
# TOSS_PAYMENTS_SECRET_KEY=test_sk_...
