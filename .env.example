# Environment Configuration
# Copy this to .env.local and fill in your API keys

# ===== ALPACA API =====
# Get from: https://app.alpaca.markets/brokerage/account/api-keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_API_BASE=https://api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# ===== OPENAI API =====
# Get from: https://platform.openai.com/api-keys
# Used by Effiroad intake, Learn/TOPIK AI grading, Whisper speech-to-text
OPENAI_API_KEY=

# TOPIK Master VN — optional model overrides (defaults: gpt-4o writing, gpt-4o-mini speaking)
# TOPIK_OPENAI_MODEL_WRITING=gpt-4o
# TOPIK_OPENAI_MODEL_SPEAKING=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# LEARN_OPENAI_API_KEY=  # Learn-only override if different from OPENAI_API_KEY

# ===== 채비 (Chaebi) — /chaebi =====
# 전부 선택 사항. 하나도 없어도 앱은 켜지고 끝까지 돈다. 자세한 건 chaebi/README.md
# CHAEBI_OPENAI_MODEL=gpt-4o-mini   # 상황 파싱 모델 (없으면 규칙 파서만 씀)
# CHAEBI_LIVE_PARTNERS=1            # 실제 제휴 커넥터를 붙였을 때만 1. 기본은 시범 모드
# 계획 저장은 아래 KV_REST_API_* 를 그대로 쓴다 (없으면 파일/메모리)

# ===== NEWS APIS =====
# Finnhub: https://finnhub.io/dashboard/api-keys
FINNHUB_API_KEY=

# NewsAPI: https://newsapi.org/account
NEWS_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/api/
ALPHA_VANTAGE_API_KEY=

# ===== DEPLOYMENT =====
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Giu (Vietnam food rescue) — custom domain
# NEXT_PUBLIC_GIU_URL=https://www.giucuu.com
# NEXT_PUBLIC_GIU_HOST=giucuu.com
# GIU_DOMAIN=giucuu.com   # for npm run giu:domain

# ===== EFFIROAD TOSS SHOP / JARVIS =====
# Full list: docs/TOSS_SHOP_SETUP.md | Handoff: docs/JARVIS_CLAUDE_HANDOFF.md
AUTH_SECRET=
CRON_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
TOSS_SHOPPING_ACCESS_KEY=
TOSS_SHOPPING_SECRET_KEY=
TOSS_SHOPPING_SANDBOX=
TOSS_SHOP_DEFAULT_CATEGORY_ID=
TOSS_SHOP_EXCHANGE_RETURN_LOCATION_ID=
DOMEGGOOK_API_KEY=
JARVIS_AUTO_EXECUTE=
JARVIS_OPENAI_MODEL=gpt-4o-mini
DRAPH_API_URL=
DRAPH_API_KEY=
HOOKABLE_API_URL=
HOOKABLE_API_KEY=
# Vercel push: VERCEL_TOKEN=... VERCEL_PROJECT_ID=... node scripts/toss-shop-production-env.mjs

# ===== 하루위드(dajeong) 로그인 + 운영 DB =====
# 아무 것도 설정하지 않으면 dajeong은 로그인 없이(기기별 익명 식별) + 로컬 파일 저장소
# (.data/dajeong/*.json)로 동작합니다 — 개발 전용 대체 수단입니다.
# DAJEONG_DATABASE_URL을 채우면: (1) 로그인 버튼이 활성화되고 (2) 동반자/공유 계획/알림/
# push 구독 등 서버 상태가 전부 Postgres(dajeong_* 테이블)로 전환됩니다. 값은 위
# DATABASE_URL과 같은 Postgres를 가리키면 됩니다 (Learn/Effiroad와는 테이블명만 분리).
# 실서비스 배포(NODE_ENV=production 또는 Vercel)에서 이 값이 비어 있으면 해당 기능들이
# 파일 저장소로 조용히 대체되지 않고 명확한 오류를 반환합니다 — 배포 전 반드시 설정하세요.
# 새 테이블 생성: npx prisma generate && npx prisma db push (그 다음 prisma/dajeong-tables.sql
# 맨 아래 partial unique index를 한 번 수동 실행 — db push는 이 구문을 적용하지 않습니다).
DAJEONG_DATABASE_URL=
DAJEONG_AUTH_SECRET=
NEXT_PUBLIC_DAJEONG_AUTH_DEMO=
# Google — https://console.cloud.google.com/apis/credentials 에서 OAuth 클라이언트 생성,
# 승인된 리디렉션 URI: https://<도메인>/dajeong/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=
# Kakao — https://developers.kakao.com/console/app 에서 카카오 로그인 활성화 후 발급.
# 리디렉션 URI: https://<도메인>/dajeong/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_ENABLED=
# Naver — https://developers.naver.com/apps 에서 애플리케이션 등록.
# 리디렉션 URI: https://<도메인>/dajeong/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEXT_PUBLIC_NAVER_ENABLED=
# Toss — 일반 사이트를 위한 공개 "토스 로그인" OAuth는 문서화되어 있지 않습니다(토스페이먼츠
# 개발자센터는 결제 API 중심). 토스 파트너 계약을 통해 실제 authorization/token/userinfo
# endpoint를 받은 경우에만 아래를 채우세요 — 다섯 값이 모두 있어야 버튼이 나타납니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_AUTHORIZATION_URL=
TOSS_TOKEN_URL=
TOSS_USERINFO_URL=
NEXT_PUBLIC_TOSS_ENABLED=

# ===== 하루위드(dajeong) 실제 장소 탐색 =====
# 없으면 OpenStreetMap fallback만 사용됩니다(평점·리뷰·영업시간 정보는 제한적). Google Cloud
# Console → Places API (New) 사용 설정 후 API 키 발급. 결제 계정 연결 필요, 실제 호출량만큼
# 과금됩니다. 참고: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
# 위와 같은 값이면 됩니다 — 브라우저에 노출되는 이름이 필요한 호출 경로가 있어 별칭으로 둡니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ===== 하루위드 발견(요즘 뜨는 것) — 전부 선택 사항 =====
# 하나도 없어도 앱은 그대로 돈다. 넣으면 그 출처만 켜진다.
#
# 한국문화정보원_한눈에보는문화정보조회서비스 — 전시·공연·축제를 기간(시작~종료)까지
# 구조화된 데이터로 준다. "며칠만 하는 것"을 정확히 아는 유일한 합법 경로.
# 발급: https://www.data.go.kr (공공데이터포털, culture.go.kr 아님!) → 회원가입 →
#      검색창에 "한눈에보는문화정보조회서비스" 검색 → 활용신청(자동 승인, 즉시 발급)
CULTURE_DATA_API_KEY=

# 서울 열린데이터광장 — 서울 지역 문화행사. 서울만 볼 거면 위 키만으로도 충분하다.
# 발급: https://data.seoul.go.kr  →  회원가입 → 인증키 신청
SEOUL_OPEN_DATA_API_KEY=

# 네이버 검색 API(NAVER API HUB) — 기관 데이터에 아직 없는 신상 가게를 블로그 반응으로
# 추정한다. 여기서 온 건 "확인된 사실"이 아니라 "요즘 얘기가 많다"까지만 말한다.
# ⚠ 네이버가 검색 API를 예전 개발자센터(developers.naver.com)에서 NAVER Cloud
#   Platform의 API HUB로 옮겼다. 예전 방식(developers.naver.com/apps/#/register)에는
#   "검색"이 더 이상 없다 — 아래 절차로 발급해야 한다.
# 발급: https://www.ncloud.com  →  네이버클라우드플랫폼 회원가입(무료) → 콘솔 로그인 →
#      "API HUB" 검색 → Search API 이용 신청 → Application 생성(블로그·지역 선택) →
#      인증 정보에서 API Key ID / API Key 확인
# 현재 한시적으로 무료(월 최대 775,000건). 이 서비스의 API Key ID를
# NAVER_SEARCH_CLIENT_ID에, API Key를 NAVER_SEARCH_CLIENT_SECRET에 넣는다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ===== 하루위드(dajeong) 실시간 푸시 알림(Web Push) =====
# 없으면 알림 계산/저장/설정 화면은 그대로 동작하지만 실제 기기로 발송되지는 않습니다
# (push-dispatch.ts가 조용히 delivered:0을 반환 — 발송 자체를 생략, 성공했다고 표시하지 않음).
# 발급: npx web-push generate-vapid-keys (web-push는 이미 의존성에 포함되어 있습니다).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 알림 수신 서비스(브라우저 push 서비스)가 문의할 수 있는 연락처. mailto: 형식.
VAPID_SUBJECT=mailto:support@effiroad.com
# 위 CRON_SECRET을 그대로 사용합니다 — /api/cron/dajeong-notifications도 같은 값을 요구합니다.
# cron-job.org 설정은 CRON.md의 "하루위드(dajeong) proactive notifications" 항목을 참고하세요.

# ===== 하루위드(dajeong) AI 예약 전화 =====
# 하루위드가 사용자를 대신해 가게에 실제로 전화를 걸어 예약한다. 셋 다 채워져야 켜지고,
# 하나라도 비면 기능은 꺼진 채로 남아 기존 전화 문구·링크 안내로 되돌아간다.
# 에피로드(RETELL_*)와 키를 공유하지 않는다 — 목소리·대본·요금이 전부 다른 제품이다.
# 설정 절차와 에이전트 프롬프트: docs/DAJEONG_BOOKING_CALL_SETUP.md
DAJEONG_RETELL_API_KEY=
DAJEONG_RETELL_BOOKING_AGENT_ID=
# Retell에 등록된 발신번호(E.164). 예: +8215881234
DAJEONG_RETELL_FROM_NUMBER=
