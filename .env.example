# Environment Configuration
# Copy this to .env.local and fill in your API keys

# ===== ALPACA API =====
# Get from: https://app.alpaca.markets/brokerage/account/api-keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_API_BASE=https://api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# ===== OPENAI API =====
# Get from: https://platform.openai.com/api-keys
# Used by Effiroad intake, Learn/TOPIK AI grading, Whisper speech-to-text
OPENAI_API_KEY=

# TOPIK Master VN — optional model overrides (defaults: gpt-4o writing, gpt-4o-mini speaking)
# TOPIK_OPENAI_MODEL_WRITING=gpt-4o
# TOPIK_OPENAI_MODEL_SPEAKING=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# LEARN_OPENAI_API_KEY=  # Learn-only override if different from OPENAI_API_KEY

# ===== NEWS APIS =====
# Finnhub: https://finnhub.io/dashboard/api-keys
FINNHUB_API_KEY=

# NewsAPI: https://newsapi.org/account
NEWS_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/api/
ALPHA_VANTAGE_API_KEY=

# ===== DEPLOYMENT =====
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Giu (Vietnam food rescue) — custom domain
# NEXT_PUBLIC_GIU_URL=https://www.giucuu.com
# NEXT_PUBLIC_GIU_HOST=giucuu.com
# GIU_DOMAIN=giucuu.com   # for npm run giu:domain

# ===== EFFIROAD TOSS SHOP / JARVIS =====
# Full list: docs/TOSS_SHOP_SETUP.md | Handoff: docs/JARVIS_CLAUDE_HANDOFF.md
AUTH_SECRET=
CRON_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
TOSS_SHOPPING_ACCESS_KEY=
TOSS_SHOPPING_SECRET_KEY=
TOSS_SHOPPING_SANDBOX=
TOSS_SHOP_DEFAULT_CATEGORY_ID=
TOSS_SHOP_EXCHANGE_RETURN_LOCATION_ID=
DOMEGGOOK_API_KEY=
JARVIS_AUTO_EXECUTE=
JARVIS_OPENAI_MODEL=gpt-4o-mini
DRAPH_API_URL=
DRAPH_API_KEY=
HOOKABLE_API_URL=
HOOKABLE_API_KEY=
# Vercel push: VERCEL_TOKEN=... VERCEL_PROJECT_ID=... node scripts/toss-shop-production-env.mjs
