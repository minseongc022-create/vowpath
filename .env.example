# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public beta: free signup + English landing (set true on Vercel)
NEXT_PUBLIC_BETA=true

# Vercel KV (required for signup on Vercel — auto-set when you attach KV)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Auth — 32+ random characters (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Password reset email (Resend — https://resend.com) — see RESEND_SETUP.md
RESEND_API_KEY=re_xxxx
EMAIL_FROM=Vowpath <onboarding@resend.dev>
# Without RESEND_API_KEY: dev only — code prints in terminal

# Twilio voice (v3) — see TWILIO_SETUP.md
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1...
# TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-url
# TWILIO_DEFAULT_USER_ID=user-uuid-from-signup

# Jobber OAuth (v2)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/callback
# JOBBER_GRAPHQL_VERSION=2025-04-16

# Job Card AI (dashboard)
OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-4o-mini

# Option A: Stripe Payment Links (one per plan)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/unlimited_xxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_FLEX=https://buy.stripe.com/flex_xxxx

# Option B: Stripe Checkout API — subscription prices
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PRICE_ID_UNLIMITED=price_xxxx    # $199/mo flat
STRIPE_PRICE_ID_FLEX=price_xxxx         # $49/mo base (usage billed separately)
# Legacy fallback:
STRIPE_PRICE_ID=price_xxxx

# Future: metered billing for Flex per-booking fee ($18/booking)
# STRIPE_PRICE_ID_FLEX_METERED=price_xxxx
