# App URL (marketing + dashboard) — no trailing slash
NEXT_PUBLIC_APP_URL=https://effiroad.com

# White-label customer links in SMS (no "effiroad" in the URL — customers should not see our brand)
#
# Option A — shop subdomain you control (recommended):
#   book.smithhvac.com  → Vercel Domains + DNS CNAME
# Option B — neutral short domain you buy (~$10/yr):
#   https://link.effiroad.com  or  https://bookmyhvac.co
#
NEXT_PUBLIC_PORTAL_URL=https://link.effiroad.com

# UI locale — en for US HVAC market (default)
NEXT_PUBLIC_LOCALE=en

# Public beta: true = free signup CTAs. For paid launch without a frontend rebuild,
# also set BILLING_ENABLED=true (server runtime) in Vercel Production.
NEXT_PUBLIC_BETA=false
BILLING_ENABLED=true

# Vercel KV (required for signup on Vercel — auto-set when you attach KV)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Auth — 32+ random characters (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Admin purge endpoint — separate from AUTH_SECRET (production only)
# PURGE_ACCOUNTS_SECRET=

# Password reset email (Resend — https://resend.com) — see RESEND_SETUP.md
RESEND_API_KEY=re_xxxx
EMAIL_FROM=Effiroad <onboarding@resend.dev>
# Without RESEND_API_KEY: dev only — code prints in terminal

# Twilio voice (v3) — see TWILIO_SETUP.md
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Optional legacy/dev shared number (production: each shop gets its own via auto-provision)
# TWILIO_PHONE_NUMBER=+1...
# TWILIO_AUTO_PROVISION=true
# TWILIO_FORCE_PROVISION=true — local dev: purchase a dedicated number per signup (paid Twilio)
# Console → Messaging → Geo permissions: enable United States (US) SMS (fixes error 21408)
# SMS_DEV_PREVIEW=1   # 1=log only; 0 or unset + live scripts = real sends
# SMS_PROBE_TO=+821055969438
# TWILIO_WEBHOOK_BASE_URL=https://effiroad.com
# TWILIO_DEFAULT_USER_ID=user-uuid-from-signup
# Optional: shop alert SMS if account phone is empty (E.164, dev only unless ALLOW_TWILIO_OWNER_ALERT=true)
# TWILIO_OWNER_ALERT_PHONE=+15125550100
# ALLOW_TWILIO_OWNER_ALERT=true   # dev only — leave unset/false in production
# ALLOW_TWILIO_DEFAULT_TENANT=true   # dev only — leave unset/false in production

# Owner email alerts (Resend — same as auth). Uses account email or:
# Platform owner alerts (new signups, etc.) — defaults to helloeffiroad@gmail.com
# PLATFORM_SIGNUP_ALERT_EMAIL=helloeffiroad@gmail.com

# Site-owner (platform operator) SMS alerts — resilience/monitoring only, distinct from
# TWILIO_OWNER_ALERT_PHONE above (which is a per-tenant shop fallback). Used by
# lib/owner-alerts.ts for OpenAI/Twilio outage alerts, repeated call failures, daily
# summary, and new-signup notifications. E.164 format.
# OWNER_ALERT_PHONE=+15125550100

# Google Maps — customer address autocomplete (Places API + Maps JavaScript API)
# Restrict key: HTTP referrers link.effiroad.com/* and your dashboard domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side address validation (optional — can reuse same key)
GOOGLE_MAPS_API_KEY=
# GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Retell conversational AI (1 → 1 booking path) — see docs/RETELL_SETUP.md
# RETELL_API_KEY=key_...
# RETELL_FORWARD_NUMBER=+1...   # Retell PSTN number Twilio <Dial>s (auto-discovered if omitted)
# RETELL_AGENT_ID=agent_6e612965cf4b69f4312deee3f8
# RETELL_LLM_ID=llm_9e819a0687ea88f77b29f8de448d
# RETELL_VOICE_ID=11labs-Sloane   # optional; auto-picks professional US English voice if omitted
# RETELL_SKIP_DTMF_MENU=true   # skip Twilio menu and connect straight to Retell (default: menu first)

# Cron: reminders at 30m, unverified after 24h — GET /api/cron/customer-verification
# CRON_SECRET=your-cron-secret

# Jobber OAuth (v2)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/callback
# Production: https://effiroad.com/api/jobber/callback
# JOBBER_GRAPHQL_VERSION=2025-04-16

# Job Card AI (dashboard)
OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-4o-mini

# Paddle Billing (merchant-of-record — no US entity required)
# https://vendors.paddle.com — build/test in sandbox first, repeat setup in
# production once business verification clears.
PADDLE_ENV=sandbox   # sandbox | production — selects API base URL
PADDLE_API_KEY=pdl_sdbx_apikey_xxxx
PADDLE_PRICE_ID_PRO=pri_xxxx         # $169/mo Pro (20 dispatches incl.)
PADDLE_PRICE_ID_PRO_OVERAGE=pri_xxxx # $12/dispatch beyond cap
PADDLE_PRICE_ID_SCALE=pri_xxxx       # $369/mo Scale (50 dispatches incl.)
PADDLE_PRICE_ID_SCALE_OVERAGE=pri_xxxx # $9/dispatch beyond cap
# Legacy alias (Pro)
PADDLE_PRICE_ID_UNLIMITED=pri_xxxx
PADDLE_PRICE_ID_FLEX=pri_xxxx         # $75/mo base (usage billed separately)
PADDLE_PRICE_ID_LITE=pri_xxxx        # $42/mo base (usage billed separately)

# Paddle.js (browser) — renders the actual checkout overlay at /pay. Set this
# page as your "Default payment link" in Paddle > Checkout > Checkout settings
# (sandbox: https://sandbox-vendors.paddle.com/checkout-settings), e.g.
# https://effiroad.com/pay — otherwise checkout.url redirects never open a
# payment form. Client-side token from Paddle > Developer Tools > Authentication
# Client-side token from Paddle > Developer Tools > Authentication
# (safe to expose in the browser — NOT the same as PADDLE_API_KEY above).
# Use either server-only PADDLE_CLIENT_TOKEN (no redeploy to rotate) or
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN (requires redeploy when changed).
PADDLE_CLIENT_TOKEN=test_xxxx
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxx

# Non-recurring price for per-dispatch overage
PADDLE_PRICE_ID_FLEX_USAGE=pri_xxxx   # $11/dispatch (Flex)
PADDLE_PRICE_ID_LITE_USAGE=pri_xxxx    # $30/dispatch (Lite)

# Beta trial-feedback cohort — offered when a user's free trial ends and they
# submit the one-line feedback prompt. Cron api/cron/beta-cohort-price-step
# steps subscriptions to locked rates after 5 years.
PADDLE_PRICE_ID_BETA_INTRO=pri_xxxx    # $129/mo Pro — 5 years
PADDLE_PRICE_ID_BETA_SCALE=pri_xxxx    # $349/mo Scale — 5 years
PADDLE_PRICE_ID_BETA_SCALE_OVERAGE=pri_xxxx # $7/dispatch Scale founder overage
PADDLE_PRICE_ID_BETA_LOCKED=pri_xxxx   # $169/mo Unlimited — after cohort
PADDLE_PRICE_ID_BETA_FLEX=pri_xxxx     # $69/mo Flex base — 5 years
PADDLE_PRICE_ID_BETA_FLEX_USAGE=pri_xxxx   # $9/dispatch Flex — 5 years
PADDLE_PRICE_ID_BETA_LITE=pri_xxxx     # $39/mo Lite base — 5 years
PADDLE_PRICE_ID_BETA_LITE_USAGE=pri_xxxx   # $25/dispatch Lite — 5 years
# Optional locked rates after cohort (defaults to standard plan prices)
# PADDLE_PRICE_ID_BETA_FLEX_LOCKED=pri_xxxx
# PADDLE_PRICE_ID_BETA_FLEX_USAGE_LOCKED=pri_xxxx
# PADDLE_PRICE_ID_BETA_LITE_LOCKED=pri_xxxx
# PADDLE_PRICE_ID_BETA_LITE_USAGE_LOCKED=pri_xxxx

# Paddle webhook signature verification (required for /api/paddle/webhook)
# Developer Tools → Notifications → destination secret
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxx

# Optional: re-transcribe call recordings (lib/call-intake/deepgram-retranscribe.ts)
# DEEPGRAM_API_KEY=

# Optional: Upstash Redis fallback if not using Vercel KV directly
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# SMS region/recipient policy
# SMS_ALLOW_KR_RECIPIENTS=true   # allow SMS to +82 numbers (dev/testing)
# OWNER_KR_PHONE_EMAILS=owner1@example.com,owner2@example.com

# Demo checkout bypass (non-dev only) — leave unset in production
# ALLOW_DEMO_CHECKOUT=true

# Twilio call recording — default enabled; set to "false" to disable
# CALL_RECORDING_ENABLED=true

# Customer booking portal URL mode
# NEXT_PUBLIC_PORTAL_USE_BOOK_SUBDOMAIN=true

# Optional: separate key for Places Autocomplete (falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY)
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
