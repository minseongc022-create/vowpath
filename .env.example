# Environment Configuration
# Copy this to .env.local and fill in your API keys

# ===== ALPACA API =====
# Get from: https://app.alpaca.markets/brokerage/account/api-keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_API_BASE=https://api.alpaca.markets
ALPACA_DATA_BASE=https://data.alpaca.markets

# ===== OPENAI API =====
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===== NEWS APIS =====
# Finnhub: https://finnhub.io/dashboard/api-keys
FINNHUB_API_KEY=

# NewsAPI: https://newsapi.org/account
NEWS_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/api/
ALPHA_VANTAGE_API_KEY=

# ===== DEPLOYMENT =====
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
