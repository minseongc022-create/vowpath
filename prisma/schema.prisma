// EFFIROAD Learn — isolated from the legacy phone/dispatch product.
// PostgreSQL via Supabase; Prisma for type-safe queries + migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  notes            Note[]
  plannerItems     PlannerItem[]
  learningProgress LearningProgress[]
  mindmapNodes     MindmapNode[]
  materials        LearningMaterial[]

  @@map("learn_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("learn_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learn_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("learn_verification_tokens")
}

// ─── Auth (NextAuth) — 하루온(dajeong), isolated from Learn/Effiroad ──────────
// Separate table set on purpose (same convention as Learn) — a dajeong login
// must never accidentally read/write another product's user rows.

model DajeongUser {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts DajeongAccount[]
  sessions DajeongSession[]

  @@map("dajeong_users")
}

model DajeongAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user DajeongUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("dajeong_accounts")
}

model DajeongSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user DajeongUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dajeong_sessions")
}

model DajeongVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("dajeong_verification_tokens")
}

// ─── Curriculum ──────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  thumbnail   String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons          Lesson[]
  mindmapNodes     MindmapNode[]
  learningProgress LearningProgress[]

  @@map("learn_courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  title       String
  description String?
  videoUrl    String?
  durationSec Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notes            Note[]
  mindmapNodes     MindmapNode[]
  learningProgress LearningProgress[]

  @@unique([courseId, slug])
  @@map("learn_lessons")
}

// ─── Learning records (realtime-synced) ──────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  title     String   @default("새 필기")
  content   String   @default("") @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@map("learn_notes")
}

model PlannerItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@map("learn_planner_items")
}

model MindmapNode {
  id        String   @id @default(cuid())
  userId    String?
  courseId  String?
  lessonId  String?
  parentId  String?
  label     String
  summary   String?  @db.Text
  x         Float    @default(0)
  y         Float    @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent   MindmapNode?  @relation("MindmapTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MindmapNode[] @relation("MindmapTree")

  @@index([courseId, lessonId])
  @@map("learn_mindmap_nodes")
}

model LearningProgress {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  lessonId       String
  watchedSec     Int      @default(0)
  completed      Boolean  @default(false)
  lastAccessedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("learn_progress")
}

// ─── AI Ingestion Engine — personal learning library ─────────────────────────

enum MaterialType {
  YOUTUBE
  PDF
  TEXT
  NOTE
}

enum MaterialStatus {
  PENDING
  EXTRACTING
  CHUNKING
  TRANSCRIBING
  ANALYZING
  READY
  FAILED
}

model LearningMaterial {
  id             String         @id @default(cuid())
  userId         String
  type           MaterialType
  status         MaterialStatus @default(PENDING)
  title          String
  sourceUrl      String?
  sourceLabel    String?
  rawText        String?        @db.Text
  fullTranscript String?        @db.Text
  searchableText String?        @db.Text
  errorMessage   String?
  tags           String[]       @default([])
  linkedCourse   String?
  linkedLesson   String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      MaterialChunk[]
  analysis    MaterialAnalysis?
  annotations MindmapAnnotation[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("learn_materials")
}

model MindmapAnnotation {
  id           String   @id @default(cuid())
  userId       String
  materialId   String
  linkedNodeId String?
  x            Float    @default(0)
  y            Float    @default(0)
  content      String   @default("") @db.Text
  color        String   @default("#FEF3C7")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, userId])
  @@map("learn_mindmap_annotations")
}

model MaterialChunk {
  id             String   @id @default(cuid())
  materialId     String
  chunkIndex     Int
  startSec       Float?
  endSec         Float?
  rawContent     String   @db.Text
  cleanedContent String?  @db.Text
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@map("learn_material_chunks")
}

model MaterialAnalysis {
  id          String   @id @default(cuid())
  materialId  String   @unique
  summary     String   @db.Text
  sections    Json     @default("[]")
  keyPoints   Json
  keywords    Json
  mindmapTree Json
  analyzedAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("learn_material_analysis")
}

// ─── 하루온(dajeong) — companion/sharing/notification operational state ──────
// Isolated the same way as DajeongUser above: dajeong_* tables only, on the
// same physical Postgres instance. `personId` here is either an account id
// ("user_<DajeongUser.id>") or an anonymous device id minted client-side —
// this store is identity-string-agnostic on purpose, matching the app's
// existing anonymous/account duality (see dajeong/lib/identity.ts). Gated by
// the same isDatabaseConfigured() flag as login; see dajeong/lib/db.ts.

model DajeongPerson {
  id        String   @id
  name      String
  updatedAt DateTime @updatedAt

  @@map("dajeong_people")
}

model DajeongCompanionInvite {
  code       String   @id
  fromId     String
  fromName   String
  relation   String
  note       String?
  status     String   @default("pending") // pending | accepted | cancelled
  acceptedBy String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([fromId, status])
  @@map("dajeong_companion_invites")
}

model DajeongCompanionLink {
  id          String   @id @default(cuid())
  // Stored with memberAId < memberBId lexicographically so the pair is always
  // reachable from either direction with one unique index, instead of two.
  memberAId   String
  memberAName String
  memberBId   String
  memberBName String
  relation    String
  createdAt   DateTime @default(now())

  @@unique([memberAId, memberBId])
  @@index([memberBId])
  @@map("dajeong_companion_links")
}

model DajeongSharedPlan {
  planId        String   @id
  ownerId       String
  ownerName     String
  companionId   String
  companionName String
  // The itinerary/prep/schedule/execution object graph is deep, highly
  // variant (many optional branches per category/visibility/live state) and
  // owned end-to-end by dajeong/lib/types.ts — normalizing every nested shape
  // into relational tables here would duplicate that type system in SQL DDL
  // for no real query benefit (nothing queries inside the plan; access is
  // always "give me plan X for participant Y"). Kept as jsonb, matching how
  // Learn stores comparably deep nested content (see e.g. MaterialAnalysis
  // above). Ownership/participant/version fields that DO need to be queried,
  // constrained, or joined are real columns.
  plan          Json
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@index([companionId])
  @@map("dajeong_shared_plans")
}

model DajeongPacePreference {
  personId     String
  companionKey String
  density      String?
  placesPerDay Int?
  notes        Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@id([personId, companionKey])
  @@map("dajeong_pace_preferences")
}

/**
 * A solo (non-shared) plan the owner opted into proactive notifications for
 * — see dajeong/lib/notification-sweep.ts. Never readable by anyone but the
 * owner; there is no companion column here at all.
 */
model DajeongRegisteredPlan {
  planId    String   @id
  ownerId   String
  plan      Json
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("dajeong_registered_plans")
}

model DajeongWeatherDigest {
  planId    String   @id
  digest    Json
  updatedAt DateTime @updatedAt

  @@map("dajeong_weather_digests")
}

/**
 * Heartbeat for the 60-second notification sweep. The sweep itself is driven by an external
 * cron this repo cannot see, so without a recorded timestamp there is no way to answer "is it
 * actually running in production?" — which is exactly the question that kept coming up.
 */
model DajeongSweepHeartbeat {
  key       String   @id
  lastRunAt DateTime
  detail    Json?

  @@map("dajeong_sweep_heartbeats")
}

/**
 * One outbound booking call 하루위드 placed on a user's behalf. Server-side because the call
 * result arrives from the voice provider's webhook long after the browser moved on — the plan
 * itself lives in the user's browser for solo plans, so there is nowhere else to land it.
 */
model DajeongBookingCall {
  id                 String    @id
  planId             String
  taskId             String
  ownerId            String
  providerCallId     String?   @unique
  toNumber           String
  placeName          String
  status             String
  outcome            String?
  confirmedDetail    String?
  offeredAlternative String?
  quotedAmount       Int?
  cancellationTerms  String?
  summary            String?
  failureReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  endedAt            DateTime?

  @@index([planId])
  @@index([ownerId])
  @@map("dajeong_booking_calls")
}

/**
 * Which discovery(발견) item ids a plan has already been notified about — without this, the
 * proactive-suggestion sweep would re-fire the same "○○ 떴어" push every 60s for as long as the
 * event stays within its notify window (worthNotifying stays true for up to 14 days).
 */
model DajeongDiscoveryDigest {
  planId      String   @id
  notifiedIds Json
  updatedAt   DateTime @updatedAt

  @@map("dajeong_discovery_digests")
}

model DajeongPushSubscription {
  id        String   @id @default(cuid())
  personId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([personId])
  @@map("dajeong_push_subscriptions")
}

model DajeongNotificationPreference {
  personId           String   @id
  masterEnabled      Boolean  @default(true)
  categories         Json
  secretPrivacyLevel String   @default("content_hidden")
  quietHoursStart    String?
  quietHoursEnd      String?
  updatedAt          DateTime @updatedAt

  @@map("dajeong_notification_preferences")
}

model DajeongNotification {
  id             String    @id @default(cuid())
  planId         String
  planVersion    Int
  targetPersonId String
  kind           String
  priority       String
  status         String // scheduled | sent | cancelled | superseded | failed
  dedupeKey      String
  scheduledFor   DateTime
  // Absolute instant (scheduledFor) is always correct regardless of this
  // field — it just records which timezone the human-facing schedule was
  // reasoned in, so a future non-Korea region can be added without a data
  // migration. See notification-engine.ts's kstToUtc for how "Asia/Seoul" is
  // currently the only timezone the itinerary engine understands at all.
  timezone       String    @default("Asia/Seoul")
  title          String
  body           String    @db.Text
  privacyAtSend  String
  deepLink       String
  relatedItemId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?
  supersededBy   String?
  failureReason  String?

  @@index([targetPersonId, status])
  @@index([status, scheduledFor])
  @@index([planId])
  @@map("dajeong_notifications")
}

/**
 * Records that anonymous device id X has been claimed into account Y — see
 * dajeong/lib/account-migration.ts. `anonymousId` is the primary key, so the
 * database itself refuses a second claim of the same anonymous id by a
 * different account; re-claiming into the SAME account is treated as a
 * harmless no-op by the application layer (idempotent retry), never by
 * relaxing this constraint.
 */
model DajeongAnonymousClaim {
  anonymousId String   @id
  accountId   String
  claimedAt   DateTime @default(now())

  @@index([accountId])
  @@map("dajeong_anonymous_claims")
}

// ─── VibeSafe ────────────────────────────────────────────────────────────────
//
// AI로 만든 앱의 핵심 기능이 새 배포 때문에 망가졌는지, 실제 고객보다 먼저
// 찾아내는 서비스. 남의 production 앱과 저장소를 다루기 때문에 다른 제품보다
// 보안 제약이 세다 — 아래 모델에서 지켜야 하는 규칙 세 가지:
//
//  1. 사용자 토큰·비밀번호 같은 값은 평문 컬럼이 없다. 이름이 `*Cipher`로
//     끝나는 컬럼만 존재하며 vibesafe/lib/crypto.ts의 AES-256-GCM을 거친다.
//  2. 보안 점검 결과(VibesafeSecurityFinding)는 **발견한 값 자체를 저장하지
//     않는다**. 저장하면 우리 DB가 남의 키 모음집이 된다.
//  3. 모든 조회는 userId로 격리한다. projectId만으로 조회하는 쿼리를 만들지
//     말 것 — 남의 프로젝트 id를 넣으면 그대로 뚫린다.

model VibesafeUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  planKey      String    @default("beta")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  projects      VibesafeProject[]
  integrations  VibesafeIntegration[]
  notifications VibesafeNotification[]

  @@map("vibesafe_users")
}

/**
 * 외부 서비스 연결(현재는 GitHub OAuth 하나). 제품 사양의 `Integration`.
 * provider를 열어둔 이유는 나중에 Vercel/Supabase 연결이 같은 자리에 붙기
 * 때문이다 — 그때 새 테이블을 만들지 않는다.
 */
model VibesafeIntegration {
  id                String    @id @default(cuid())
  userId            String
  provider          String    @default("github")
  /// pat | app_installation — 아래 accessTokenCipher/installationId 중 어느 쪽이
  /// 채워졌는지를 가른다. GitHub App 쪽은 장기 토큰을 아예 저장하지 않는다.
  authKind          String    @default("pat")
  /// read | write — 쓰기 연결은 기본 연결과 **별도의 GitHub App**이다.
  /// 자동 수정을 안 쓰는 사람에게 쓰기 권한을 요구하지 않기 위해 나눠 뒀다.
  accessLevel       String    @default("read")
  externalId        String
  externalLogin     String
  accessTokenCipher String?
  installationId    String?
  scopes            String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  revokedAt         DateTime?

  user VibesafeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accessLevel])
  @@map("vibesafe_integrations")
}

model VibesafeProject {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// setup → analyzing → review(흐름 확인 대기) → active → paused
  status     String    @default("setup")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  /// 공개 상태 페이지·README 배지용 slug. 켠 사람만 생긴다.
  publicSlug   String? @unique
  publicStatus Boolean @default(false)

  user              VibesafeUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository        VibesafeRepositoryConnection?
  deploymentTargets VibesafeDeploymentTarget[]
  appModels         VibesafeAppModel[]
  flows             VibesafeCriticalFlow[]
  testRuns          VibesafeTestRun[]
  baselines         VibesafeFlowBaseline[]
  incidents         VibesafeIncident[]
  findings          VibesafeSecurityFinding[]
  credential        VibesafeTestCredential?
  permission        VibesafeProjectPermission?
  actionLogs        VibesafeActionLog[]
  diagnoses         VibesafeDiagnosis[]
  fixProposals      VibesafeFixProposal[]
  securityProbes    VibesafeSecurityProbe[]

  @@index([userId, createdAt])
  @@map("vibesafe_projects")
}

model VibesafeRepositoryConnection {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  provider            String   @default("github")
  owner               String
  repo                String
  repoExternalId      String?
  defaultBranch       String   @default("main")
  isPrivate           Boolean  @default(false)
  /// GitHub webhook 공유 비밀 — 서명 검증용이라 평문으로 두면 위조가 가능해진다.
  webhookSecretCipher String?
  webhookExternalId   String?
  lastAnalyzedSha     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([owner, repo])
  @@map("vibesafe_repository_connections")
}

/**
 * 검사 대상이 되는 실제 배포처. MVP는 Vercel만 실제로 검증하지만 platform을
 * 컬럼으로 둔 이유는 Render/Railway/Firebase가 붙을 때 **테이블이 아니라 값만**
 * 늘어나게 하기 위해서다.
 */
model VibesafeDeploymentTarget {
  id         String    @id @default(cuid())
  projectId  String
  kind       String    @default("production")
  platform   String    @default("vercel")
  baseUrl    String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@map("vibesafe_deployment_targets")
}

/**
 * AI가 저장소를 읽고 만든 "이 앱은 무엇인가" 모델.
 * `fingerprint`는 분석에 실제로 넣은 입력(선별된 파일 경로+해시)의 요약이다.
 * 매 검사마다 저장소 전체를 다시 AI에 넣지 않기 위한 캐시 키 — 같은 지문이면
 * 분석을 건너뛴다. commitSha를 캐시 키로 쓰지 않는 이유: README 오타 하나만
 * 고쳐도 sha가 바뀌지만 앱의 핵심 흐름은 그대로이기 때문이다.
 */
model VibesafeAppModel {
  id          String   @id @default(cuid())
  projectId   String
  commitSha   String?
  fingerprint String
  appType     String
  summary     String
  stack       Json
  routes      Json
  createdAt   DateTime @default(now())

  project  VibesafeProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flows    VibesafeCriticalFlow[]
  findings VibesafeSecurityFinding[]

  @@unique([projectId, fingerprint])
  @@index([projectId, createdAt])
  @@map("vibesafe_app_models")
}

/**
 * 핵심 사용자 흐름 하나.
 * `key`는 baseline 비교의 축이다 — 재분석으로 행이 새로 생겨도 같은 흐름이면
 * 같은 key를 유지해야 "지난주엔 됐는데 지금 깨졌다"를 말할 수 있다. 그래서
 * (projectId, key)가 유니크다.
 * `riskLevel`:
 * safe    — 읽기/탐색/로그인처럼 되돌릴 수 있는 행동
 * caution — 데이터를 만들지만 사용자가 확인하면 실행 가능
 * blocked — 결제·발송·삭제처럼 금전/외부효과가 발생. MVP에서는 실행하지 않는다.
 */
model VibesafeCriticalFlow {
  id          String   @id @default(cuid())
  projectId   String
  appModelId  String?
  key         String
  title       String
  description String?
  category    String   @default("other")
  /// pending(사용자 확인 대기) | active | disabled
  status      String   @default("pending")
  riskLevel   String   @default("safe")
  riskReason  String?
  sortOrder   Int      @default(0)
  /// ai | user — 사용자가 손댄 흐름을 재분석이 덮어쓰지 않게 하는 표시
  source      String   @default("ai")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  VibesafeProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appModel VibesafeAppModel?  @relation(fields: [appModelId], references: [id], onDelete: SetNull)
  steps    VibesafeFlowStep[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@map("vibesafe_critical_flows")
}

/**
 * 흐름의 한 단계. `value`에는 절대 비밀번호를 넣지 않는다 — 로그인 단계는
 * value를 비우고 `secretRef`(= "username" | "password")로 프로젝트 테스트
 * 계정을 가리키고, 실제 값은 실행 직전에 복호화해서 주입한다.
 */
model VibesafeFlowStep {
  id          String  @id @default(cuid())
  flowId      String
  sortOrder   Int
  action      String
  selector    String?
  value       String?
  secretRef   String?
  description String
  optional    Boolean @default(false)

  flow VibesafeCriticalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, sortOrder])
  @@map("vibesafe_flow_steps")
}

/**
 * 검사 1회.
 * `dedupeKey`가 유니크인 것이 중복 실행 방지의 전부다. 같은 커밋에 대한
 * webhook이 두 번 와도(GitHub는 실제로 재전송한다) 두 번째 insert가 DB에서
 * 튕긴다 — 애플리케이션 레벨의 "이미 있나요?" 조회로는 동시 요청을 못 막는다.
 * `claimToken`은 워커가 집어간 작업을 다른 워커가 또 집어가지 못하게 한다.
 */
model VibesafeTestRun {
  id         String    @id @default(cuid())
  projectId  String
  /// manual | github | schedule
  trigger    String    @default("manual")
  /// queued | running | passed | failed | cancelled
  status     String    @default("queued")
  dedupeKey  String    @unique
  commitSha  String?
  claimToken String?
  claimedAt  DateTime?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  attempts   Int       @default(0)
  error      String?
  /// 이 실행 결과를 baseline으로 승격했는지
  baselineAt DateTime?
  /// PR 프리뷰 검사일 때 — 어느 PR의 어느 주소를 봤는지
  prNumber   Int?
  targetUrl  String?

  project VibesafeProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results VibesafeTestResult[]

  @@index([projectId, queuedAt])
  @@index([status, queuedAt])
  @@map("vibesafe_test_runs")
}

model VibesafeTestResult {
  id                    String   @id @default(cuid())
  runId                 String
  flowId                String?
  flowKey               String
  flowTitle             String
  /// passed | failed | skipped
  status                String
  startedAt             DateTime
  finishedAt            DateTime
  durationMs            Int
  failedStepOrder       Int?
  failedStepDescription String?
  errorMessage          String?
  url                   String?
  screenshotId          String?

  run VibesafeTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([flowKey])
  @@map("vibesafe_test_results")
}

/**
 * 실패 순간 화면. 별도 테이블인 이유는 결과 조회(대시보드)가 base64 수백 KB를
 * 매번 끌고 오지 않게 하기 위해서다. 용량 상한은 앱에서 강제한다.
 */
model VibesafeScreenshot {
  id          String   @id @default(cuid())
  projectId   String
  contentType String   @default("image/jpeg")
  data        String
  bytes       Int
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("vibesafe_screenshots")
}

/**
 * "이 흐름은 이 시점엔 분명히 됐다"는 기준점. 회귀 판정의 기준.
 */
model VibesafeFlowBaseline {
  id            String   @id @default(cuid())
  projectId     String
  flowKey       String
  runId         String
  commitSha     String?
  establishedAt DateTime @default(now())

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, flowKey])
  @@map("vibesafe_flow_baselines")
}

/**
 * 정상이던 흐름이 깨진 사건. 같은 장애가 이어지는 동안 행 하나를 유지한다.
 */
model VibesafeIncident {
  id                    String    @id @default(cuid())
  projectId             String
  flowKey               String
  flowTitle             String
  /// open | resolved
  status                String    @default("open")
  severity              String    @default("high")
  firstRunId            String
  lastRunId             String
  failedStepDescription String?
  errorMessage          String?
  detectedAt            DateTime  @default(now())
  resolvedAt            DateTime?
  lastNotifiedAt        DateTime?

  project       VibesafeProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications VibesafeNotification[]

  @@index([projectId, status])
  @@map("vibesafe_incidents")
}

/**
 * 알림. `dedupeKey`+`channel` 유니크가 알림 폭탄을 막는다 — 같은 장애가
 * 30분 동안 6번 검사돼도 행은 하나다.
 */
model VibesafeNotification {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  incidentId String?
  /// regression | recovered | analysis_completed
  kind       String
  /// inapp | email
  channel    String    @default("inapp")
  title      String
  body       String
  dedupeKey  String
  readAt     DateTime?
  sentAt     DateTime?
  failedAt   DateTime?
  createdAt  DateTime  @default(now())

  user     VibesafeUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident VibesafeIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey, channel])
  @@index([userId, createdAt])
  @@map("vibesafe_notifications")
}

/**
 * 저장소 분석 중 눈에 띈 명백한 위험.
 * ★ `evidence`에 발견한 값 자체를 넣지 않는다. 마스킹된 흔적("sk-...abcd")과
 * 위치만 남긴다. 전문 스캐너를 만드는 게 목적이 아니고, 남의 키를 우리 DB에
 * 모아두는 순간 이 서비스 자체가 제일 값진 표적이 된다.
 */
model VibesafeSecurityFinding {
  id         String   @id @default(cuid())
  projectId  String
  appModelId String?
  /// high | medium | low
  severity   String
  rule       String
  title      String
  filePath   String
  line       Int?
  evidence   String
  advice     String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  project  VibesafeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appModel VibesafeAppModel? @relation(fields: [appModelId], references: [id], onDelete: SetNull)

  @@unique([projectId, rule, filePath, line])
  @@index([projectId, severity])
  @@map("vibesafe_security_findings")
}

/**
 * 로그인이 필요한 흐름을 돌리기 위한 테스트 전용 계정.
 * 사용자에게 "실계정 말고 테스트 계정을 넣으라"고 화면에서 명시한다.
 */
model VibesafeTestCredential {
  id             String   @id @default(cuid())
  projectId      String   @unique
  label          String   @default("테스트 계정")
  usernameCipher String
  passwordCipher String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("vibesafe_test_credentials")
}

/**
 * 제품 분석 이벤트. 유료화 판단 근거가 되므로 삭제하지 않고 쌓는다.
 */
model VibesafeAnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("vibesafe_analytics_events")
}

/**
 * 월별 사용량. 지금은 한도만 걸고, 나중에 요금제의 근거가 된다.
 */
model VibesafeUsageCounter {
  id        String   @id @default(cuid())
  userId    String
  periodKey String
  /// test_runs | ai_analyses | browser_ms
  metric    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey, metric])
  @@map("vibesafe_usage_counters")
}

/**
 * GitHub webhook 재전송을 걸러내는 자리. deliveryId가 유니크인 게 전부다.
 */
model VibesafeWebhookDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  projectId  String?
  eventType  String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("vibesafe_webhook_deliveries")
}

// ─── VibeSafe 2 — 진단·수정·보안 ────────────────────────────────────────────
//
// 1단계 제품은 "보고 알려주는" 것까지였다. 여기서부터는 남의 운영 앱에
// **손을 대는** 영역이라 규칙이 하나 더 붙는다:
//
//   사용자가 명시적으로 권한을 올리지 않으면 아무것도 하지 않는다.
//
// 권한은 화면에서 한 단계씩 올리고, 언제든 내릴 수 있고, 올린 기록과
// 그 권한으로 한 모든 행동이 남는다. "설정 어딘가에 체크박스가 켜져 있어서
// 나도 모르게 내 저장소에 PR이 생겼다"는 일이 일어나면 안 된다.

/**
 * 프로젝트별 권한 사다리.
 * watch    — 감시(기본, 항상 켜짐). 저장소 읽기 + 브라우저 검사.
 * diagnose — 실패 원인 분석. 커밋 목록과 변경 파일을 AI에 넘긴다.
 * proposePr— 수정안을 PR로 올린다. 쓰기 권한이 붙은 별도 연결이 있어야 켜진다.
 * rollback — 배포를 이전 버전으로 되돌린다. 되돌릴 수 있는 행동만 여기 해당.
 * ★ 코드를 main에 직접 push하는 단계는 **의도적으로 없다**. 되돌릴 수 없는
 * 행동을 자동화하지 않는다는 이 제품의 원칙이 여기서도 같다.
 */
model VibesafeProjectPermission {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  diagnose           Boolean  @default(false)
  proposePr          Boolean  @default(false)
  rollback           Boolean  @default(false)
  /// 롤백은 사고가 나면 크므로 하루 한도를 둔다.
  rollbackDailyLimit Int      @default(2)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("vibesafe_project_permissions")
}

/**
 * 권한으로 한 모든 행동의 기록.
 * 이 표가 있어야 "VibeSafe가 내 저장소에 뭘 했지?"에 답할 수 있다. 답할 수
 * 없으면 아무도 권한을 올려주지 않는다 — 4위 해자(신뢰로 권한을 얻는 것)는
 * 이 기록 위에서만 성립한다.
 */
model VibesafeActionLog {
  id         String   @id @default(cuid())
  projectId  String
  /// permission_granted | permission_revoked | diagnosis | pr_opened | rollback | probe
  action     String
  /// 사용자가 눌렀는가, 시스템이 자동으로 했는가
  actor      String   @default("system")
  summary    String
  detail     Json?
  incidentId String?
  createdAt  DateTime @default(now())

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("vibesafe_action_logs")
}

/**
 * 사용자가 "이건 오탐이었다"고 표시한 기록.
 * 이게 신뢰 점수의 원천이다. 오탐률이 낮다는 걸 숫자로 보여줄 수 있어야
 * 사용자가 다음 권한 단계를 열어준다. 동시에 우리 스스로 흐름 품질을
 * 측정하는 유일한 객관적 지표이기도 하다.
 */
model VibesafeIncidentVerdict {
  id         String   @id @default(cuid())
  projectId  String
  incidentId String   @unique
  /// real | false_alarm
  verdict    String
  note       String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@map("vibesafe_incident_verdicts")
}

/**
 * 일별 흐름 통계 롤업.
 * ★ 왜 롤업을 따로 두는가
 * "지난 90일 안정성"을 매번 TestResult 원본에서 세면, 검사가 쌓일수록 화면이
 * 느려진다. 이력이 이 제품의 1번 해자인데 이력 화면이 느리면 해자가 아니라
 * 짐이 된다. 하루 한 줄로 접어둔다.
 */
model VibesafeFlowDailyStat {
  id        String   @id @default(cuid())
  projectId String
  flowKey   String
  /// UTC 기준 그 날 00:00
  day       DateTime
  passed    Int      @default(0)
  failed    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([projectId, flowKey, day])
  @@index([projectId, day])
  @@map("vibesafe_flow_daily_stats")
}

/**
 * 실패 원인 진단 결과.
 * 마지막 정상 시점 이후 들어온 커밋과 실패한 흐름을 함께 보고 원인 후보를
 * 순위화한다. 자동 수정은 반드시 이 진단을 근거로만 만들어진다 — 근거 없는
 * 수정안은 사용자가 믿을 이유가 없다.
 */
model VibesafeDiagnosis {
  id         String   @id @default(cuid())
  projectId  String
  incidentId String
  /// 마지막 정상 커밋 → 실패 시점 커밋
  fromSha    String?
  toSha      String?
  summary    String
  /// [{sha, message, files, confidence, reason}]
  suspects   Json
  /// AI가 제안한 수정 방향(설명). 실제 패치는 FixProposal에 있다.
  suggestion String?
  provider   String?
  createdAt  DateTime @default(now())

  project   VibesafeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposals VibesafeFixProposal[]

  @@index([projectId, createdAt])
  @@index([incidentId])
  @@map("vibesafe_diagnoses")
}

/**
 * 수정 제안 1건.
 * ★ status가 `applied`여도 그건 "PR을 열었다"는 뜻이지 "고쳤다"가 아니다.
 * 머지는 사람이 한다. 이 구분이 흐려지는 순간 제품이 위험해진다.
 */
model VibesafeFixProposal {
  id          String    @id @default(cuid())
  projectId   String
  diagnosisId String?
  incidentId  String?
  /// code_pr | rollback
  kind        String
  /// draft | proposed | opened | rejected | failed | superseded
  status      String    @default("draft")
  title       String
  rationale   String
  /// 변경할 파일들 [{path, before, after}] — 미리보기에 그대로 쓴다
  changes     Json?
  branchName  String?
  prUrl       String?
  prNumber    Int?
  error       String?
  createdAt   DateTime  @default(now())
  openedAt    DateTime?

  project   VibesafeProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diagnosis VibesafeDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("vibesafe_fix_proposals")
}

/**
 * 배포 롤백 기록.
 * 롤백은 되돌릴 수 있는 행동이라 권한만 있으면 자동으로 한다. 대신 하루
 * 한도와 쿨다운을 둬서, 잘못된 판정이 배포를 계속 앞뒤로 흔드는 일
 * (flapping)을 막는다.
 */
model VibesafeRollback {
  id           String   @id @default(cuid())
  projectId    String
  incidentId   String?
  platform     String   @default("vercel")
  fromDeployId String?
  toDeployId   String?
  /// requested | succeeded | failed
  status       String   @default("requested")
  reason       String
  error        String?
  triggeredBy  String   @default("system")
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("vibesafe_rollbacks")
}

/**
 * 실제 배포 주소에 대고 한 외부 점검 결과.
 * ★ 이건 침입 탐지도 방화벽도 아니다
 * 우리는 남의 요청 경로에 끼어 있지 않으므로 실시간으로 공격을 막을 수 없다.
 * 대신 **공격자가 제일 먼저 보는 것을 우리가 먼저 본다** — 인터넷에 그대로
 * 열려 있는 .env, 브라우저에서 닿는 관리자 키, 인증 없이 열리는 관리자 경로.
 * 바이브코딩 앱이 털리는 경로는 거의 다 이 목록 안에 있다.
 */
model VibesafeSecurityProbe {
  id          String    @id @default(cuid())
  projectId   String
  probe       String
  severity    String
  title       String
  /// open | fixed | accepted
  status      String    @default("open")
  target      String
  evidence    String
  advice      String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  project VibesafeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, probe, target])
  @@index([projectId, status])
  @@map("vibesafe_security_probes")
}

/**
 * 비식별 실패 지문 집계.
 * ★ 여기에는 어느 프로젝트인지도, 어떤 주소인지도 남기지 않는다
 * 남기는 건 "이런 모양의 실패가 이 시각에 몇 건 있었다"뿐이다. 그것만으로도
 * "지금 Supabase가 문제다"를 말할 수 있고, 고객이 1명인 경쟁사는 이 신호를
 * 영원히 만들 수 없다. 대신 이 표에 프로젝트 식별자가 들어가는 순간 이건
 * 해자가 아니라 사고가 된다.
 */
model VibesafeFailureSignature {
  id            String   @id @default(cuid())
  /// 오류 모양을 정규화해 해시한 값
  signature     String
  /// UTC 시간 단위 버킷
  hourBucket    DateTime
  category      String
  count         Int      @default(1)
  /// 서로 다른 프로젝트 몇 개에서 났는지 (숫자만, 식별자 없음)
  projectSpread Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@unique([signature, hourBucket])
  @@index([hourBucket])
  @@map("vibesafe_failure_signatures")
}
