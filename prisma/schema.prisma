// EFFIROAD Learn — isolated from the legacy phone/dispatch product.
// PostgreSQL via Supabase; Prisma for type-safe queries + migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  notes            Note[]
  plannerItems     PlannerItem[]
  learningProgress LearningProgress[]
  mindmapNodes     MindmapNode[]
  materials        LearningMaterial[]

  @@map("learn_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("learn_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learn_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("learn_verification_tokens")
}

// ─── Curriculum ──────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  thumbnail   String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons          Lesson[]
  mindmapNodes     MindmapNode[]
  learningProgress LearningProgress[]

  @@map("learn_courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  title       String
  description String?
  videoUrl    String?
  durationSec Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notes            Note[]
  mindmapNodes     MindmapNode[]
  learningProgress LearningProgress[]

  @@unique([courseId, slug])
  @@map("learn_lessons")
}

// ─── Learning records (realtime-synced) ──────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  title     String   @default("새 필기")
  content   String   @default("") @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@map("learn_notes")
}

model PlannerItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@map("learn_planner_items")
}

model MindmapNode {
  id        String   @id @default(cuid())
  userId    String?
  courseId  String?
  lessonId  String?
  parentId  String?
  label     String
  summary   String?  @db.Text
  x         Float    @default(0)
  y         Float    @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent   MindmapNode?  @relation("MindmapTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MindmapNode[] @relation("MindmapTree")

  @@index([courseId, lessonId])
  @@map("learn_mindmap_nodes")
}

model LearningProgress {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  lessonId       String
  watchedSec     Int      @default(0)
  completed      Boolean  @default(false)
  lastAccessedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("learn_progress")
}

// ─── AI Ingestion Engine — personal learning library ─────────────────────────

enum MaterialType {
  YOUTUBE
  PDF
  TEXT
  NOTE
}

enum MaterialStatus {
  PENDING
  EXTRACTING
  CHUNKING
  TRANSCRIBING
  ANALYZING
  READY
  FAILED
}

model LearningMaterial {
  id             String         @id @default(cuid())
  userId         String
  type           MaterialType
  status         MaterialStatus @default(PENDING)
  title          String
  sourceUrl      String?
  sourceLabel    String?
  rawText        String?        @db.Text
  fullTranscript String?        @db.Text
  searchableText String?        @db.Text
  errorMessage   String?
  tags           String[]       @default([])
  linkedCourse   String?
  linkedLesson   String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks   MaterialChunk[]
  analysis MaterialAnalysis?
  annotations MindmapAnnotation[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("learn_materials")
}

model MindmapAnnotation {
  id           String   @id @default(cuid())
  userId       String
  materialId   String
  linkedNodeId String?
  x            Float    @default(0)
  y            Float    @default(0)
  content      String   @default("") @db.Text
  color        String   @default("#FEF3C7")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, userId])
  @@map("learn_mindmap_annotations")
}

model MaterialChunk {
  id             String   @id @default(cuid())
  materialId     String
  chunkIndex     Int
  startSec       Float?
  endSec         Float?
  rawContent     String   @db.Text
  cleanedContent String?  @db.Text
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@map("learn_material_chunks")
}

model MaterialAnalysis {
  id          String   @id @default(cuid())
  materialId  String   @unique
  summary     String   @db.Text
  sections    Json     @default("[]")
  keyPoints   Json
  keywords    Json
  mindmapTree Json
  analyzedAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("learn_material_analysis")
}
