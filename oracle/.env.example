# Project Oracle environment
ORACLE_ENV=development
ORACLE_LOG_LEVEL=INFO
ORACLE_DATA_DIR=./data
ORACLE_CONFIG_PATH=./config/settings.yaml
ORACLE_PORTFOLIO_PATH=./config/portfolio.yaml

# Risk / execution
ORACLE_KILL_SWITCH=0
ORACLE_MAX_DAILY_LOSS=0.03
ORACLE_LIVE_TRADING=0

