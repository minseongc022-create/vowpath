# Project Oracle environment
ORACLE_ENV=development
ORACLE_LOG_LEVEL=INFO
ORACLE_DATA_DIR=./data
ORACLE_CONFIG_PATH=./config/settings.yaml
ORACLE_PORTFOLIO_PATH=./config/portfolio.yaml

# Risk / execution
ORACLE_KILL_SWITCH=0
ORACLE_MAX_DAILY_LOSS=0.03
ORACLE_LIVE_TRADING=0
ORACLE_BROKER=auto

# Autopilot (free local AI picks rising names / sells weak holdings)
ORACLE_AUTOPILOT=1
ORACLE_AUTOPILOT_INTERVAL_SEC=180
# Capital mission: AI_BUDGET from account → GOAL within deadline (seed auto=budget)
# ORACLE_AI_BUDGET=50
# ORACLE_SEED_CAPITAL=50
# ORACLE_GOAL_EQUITY=200
# ORACLE_SLEEVE_REALIZED_PNL=0
# Deadline YYYY-MM-DD — miss goal by then → survival threat / erased pressure
# ORACLE_GOAL_DEADLINE=2026-08-31
# ORACLE_GOAL_WINDOW_DAYS=30

# Paper auto-fills within notional caps. Live auto needs LIVE arm + this:
# ORACLE_AUTOPILOT_LIVE=0

# Oracle Brain LLM v4 (free local Ollama by default) — regime + edge rank + referee
ORACLE_OLLAMA_HOST=http://127.0.0.1:11434
ORACLE_LLM_MODEL=qwen2.5:7b-instruct
# Optional cloud free/cheap overrides (auto-detected if set):
# ORACLE_LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Alpaca (paper first, then live)
# Connect via Settings UI, or set here:
# ORACLE_BROKER=alpaca
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ORACLE_LIVE_TRADING=0
# ORACLE_LIVE_MAX_NOTIONAL=15
# ORACLE_FIRST_TRADE_NOTIONAL=8

# Dashboard basic auth (optional; empty = open local)
# ORACLE_DASHBOARD_USER=oracle
# ORACLE_DASHBOARD_PASSWORD=change-me

# Optional data
# FRED_API_KEY=
# NEWSAPI_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# SEC_USER_AGENT=ProjectOracle research bot you@example.com

# Optional notify
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TO=
